# Copie para .env.local (dev) ou configure na hospedagem. Nunca commite o arquivo real.

# Postgres 16+. Em hospedagem gerenciada, inclua ?sslmode=require
DATABASE_URL=postgres://prumo:prumo@localhost:5432/prumo

# URL pública do app (https em produção — a Pluggy só entrega webhooks em HTTPS)
APP_URL=http://localhost:3000

# Pluggy: dashboard.pluggy.ai → Applications. O secret aparece uma vez só; guarde num cofre.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Segredo enviado pela Pluggy em cada webhook (header x-prumo-webhook-secret). Gere com:
#   openssl rand -hex 32
PLUGGY_WEBHOOK_SECRET=

# Chave AES-256 para campos cifrados (segredo do 2FA). Gere com:
#   openssl rand -base64 32
# Perder esta chave = refazer o 2FA com scripts/create-user.ts
FIELD_ENCRYPTION_KEY=

# false para não rodar o worker dentro do servidor web (hospedagem serverless, ex.: Vercel):
# o webhook processa o job na hora e o cron diário (/api/cron) é a reserva
WORKER_ENABLED=true

# Só na Vercel: protege /api/cron (a Vercel o envia como Bearer). Gere com: openssl rand -hex 32
CRON_SECRET=
